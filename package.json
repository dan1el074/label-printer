{
    "name": "imprime-etiquetas",
    "version": "2.0.1",
    "description": "Software desktop que tem como objetivo imprimir etiquetas de diversos tipos e tamanhos",
    "scripts": {
        "build": "tsc && node src/scripts/copy-assets.cjs",
        "build:prod": "npm run build && cd dist && npm install && npm run build:prod && npm run config:prod && npm run clean-dist",
        "start:dev": "npm run build:dev && electron ./dist/main.js",
        "build:dev": "npm run build",
        "test": "npm run build && node --test tests/*.cjs"
    },
    "keywords": [
        "Electron",
        "typescript"
    ],
    "author": "Daniel Rodrigues de Vargas",
    "devDependencies": {
        "@electron-forge/cli": "^7.3.0",
        "@types/node": "^20.14.10",
        "copyfiles": "^2.4.1",
        "electron": "^28.1.0",
        "globals": "^15.8.0",
        "mkdirp": "^3.0.1",
        "rimraf": "^6.0.1",
        "typescript": "^4.8.3"
    },
    "dependencies": {
        "fs": "^0.0.1-security",
        "pdf-lib": "^1.17.1",
        "pdf-to-printer": "^5.6.0"
    }
}
