{
    "title": "100x70 - Código de barras",
    "width": 100,
    "height": 70,
    "collumn": 1,
    "source": "foccoerp",
    "variables": [
        { "name": "cod_item" }
    ],
    "body": [
        {
            "type": "text",
            "value": "%desc_tecnica%",
            "options": { "maxWidth": 90, "maxLines": 2 }
        },
        {
            "type": "barcode",
            "format": "EAN13",
            "value": "%cod_barra%",
            "options": {
                "y": 23,
                "width": 90,
                "height": 36,
                "showText": true,
                "fontSize": 9
            }
        }
    ],
    "options": {
        "fontSize": 11,
        "bold": false,
        "lineHeight": 11,
        "marginTop": 22
    }
}
